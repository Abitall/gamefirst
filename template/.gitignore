# Node dependencies, reinstalled from the lockfile.
node_modules/

# Build output, regenerated by verify or by a playtest build.
dist/
dist-play/

# Coverage reports, regenerated by the test run.
coverage/

# Secrets and local overrides. .env.example is documentation and stays tracked.
.env
.env.*
!.env.example

# Logs and temp files, including generated logs inside runs/ and evidence/.
*.log
*.tmp

# OS metadata.
.DS_Store
Thumbs.db
desktop.ini

# Editor state, not project state.
.vscode/
.idea/
